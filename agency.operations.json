    "create_draft": {
      "method": "POST",
      "path": "/drafts",
      "call": "CreateDraft",
      "action": "agency.draft.create",
      "status": 201,
      "title": "Start a draft",
      "description": "Start an editable copy of the organization. An empty forked_from_type starts from nothing; \"draft\" forks another open draft by its id; \"publication\" forks a published tag, materializing its document.",
      "args": [
        {
          "from": "body",
          "as": "description",
          "description": "What this round of editing is for."
        },
        {
          "from": "body",
          "as": "forked_from_id",
          "description": "The draft's id, or the publication's tag, depending on forked_from_type."
        },
        {
          "from": "body",
          "as": "forked_from_type",
          "description": "Empty, \"draft\" or \"publication\"."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ],
      "tool": "agency_create_draft"
    },
    "list_drafts": {
      "method": "GET",
      "path": "/drafts",
      "call": "ListDrafts",
      "action": "agency.draft.list",
      "title": "List drafts",
      "description": "List every draft, oldest first, narrowed by the filter.",
      "args": [
        {
          "from": "query",
          "whole": true
        }
      ],
      "returns": [
        {
          "body": true
        }
      ],
      "tool": "agency_list_drafts"
    },
    "get_draft": {
      "method": "GET",
      "path": "/drafts/{draft_id}",
      "call": "GetDraft",
      "action": "agency.draft.read",
      "title": "Read draft",
      "description": "Read one draft's header — what it is for, what it was forked from, and whether it is still open.",
      "args": [
        {
          "from": "path",
          "as": "draft_id",
          "description": "The draft to read."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ],
      "tool": "agency_get_draft"
    },
    "update_draft": {
      "method": "PATCH",
      "path": "/drafts/{draft_id}",
      "call": "UpdateDraftDescription",
      "action": "agency.draft.update",
      "title": "Describe draft",
      "description": "Change what a draft says it is for. Only an open draft may be edited.",
      "args": [
        {
          "from": "path",
          "as": "draft_id",
          "description": "The draft to describe."
        },
        {
          "from": "body",
          "as": "description",
          "required": true,
          "description": "What this round of editing is for."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ],
      "tool": "agency_update_draft_description"
    },
